<?xml version="1.0" encoding="utf-8"?>
<!-- Restore sources for the conformance harness (PRUVZ-101).

     The source mapping pins every Pruvz.* package to the locally built
     artifacts/nupkg folder ONLY. Without it, once a version is published,
     nuget.org could satisfy the packaged-mode PackageReference with the
     published package instead of the freshly built one, and the harness would
     silently judge the old published bytes rather than the working tree's
     build (the SHA-256 guard cannot tell: loaded and cached would both be the
     published assembly). Default (ProjectReference) mode never asks for a
     Pruvz.* package, so the local folder is never queried there — but it must
     still EXIST for any restore to succeed (NU1301), which is why
     artifacts/nupkg/.gitkeep is tracked. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="local-artifacts" value="../../artifacts/nupkg" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="local-artifacts">
      <package pattern="Pruvz.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
