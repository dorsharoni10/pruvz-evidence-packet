# Isolated offline acceptance image for the PyPI package (PRUVZ-101).
# The build stage has network (pip resolves the wheel's dependencies); the
# check itself runs with `docker run --network none`, and the image contains
# no repository clone — only the installed package and check.sh.
FROM python:3.12-slim-bookworm

COPY conformance/python/dist/ /dist/
RUN pip install --no-cache-dir /dist/*.whl

COPY conformance/isolated/check.sh /check.sh
ENTRYPOINT ["/bin/sh", "/check.sh"]
