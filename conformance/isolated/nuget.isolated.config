<?xml version="1.0" encoding="utf-8"?>
<!-- Restore sources for the isolated dotnet-tool install (PRUVZ-101).

     The source mapping pins every Pruvz.* package to the /nupkg folder copied
     into the image, so the tool under test is always the freshly built one —
     never a same-versioned package that nuget.org already carries after a
     release. Transitive dependencies still come from nuget.org (the build
     stage has network; the check itself runs in a container with no network). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="local-nupkg" value="/nupkg" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="local-nupkg">
      <package pattern="Pruvz.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
